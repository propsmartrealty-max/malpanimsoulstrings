{
  "name": "malpanimsoul",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"let sha = process.env.CF_PAGES_COMMIT_SHA || process.env.GITHUB_SHA; if (!sha) { try { sha = require('child_process').execSync('git rev-parse HEAD').toString().trim(); } catch(e) { sha = 'local'; } } require('fs').writeFileSync('public/version.txt', sha);\" && next build",
    "build:cf": "npm run build",
    "pages:build": "npm run build",
    "postbuild": "node scripts/ping-indexnow.js",
    "start": "next start",
    "lint": "eslint",
    "seo-audit": "node scripts/validate-schema-graph.js",
    "validate-schemas": "node scripts/validate-schema-graph.js"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "cheerio": "^1.2.0",
    "marked": "^18.0.4",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
